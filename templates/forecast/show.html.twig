{% extends 'base.html.twig' %}

{% block title %}Forecast{% endblock %}

{% block body %}
    <h1>Forecast</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ forecast.id }}</td>
            </tr>
            <tr>
                <th>Temperature</th>
                <td>{{ forecast.temperature }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ forecast.date ? forecast.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ forecast.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_forecast_index') }}" class="btn btn-primary">back to list</a>

    {% if is_granted('ROLE_FORECAST_EDIT') %}
    <a href="{{ path('app_forecast_edit', {'id': forecast.id}) }}" class="btn btn-primary">edit</a>
    {% endif %}

    {{ include('forecast/_delete_form.html.twig') }}
{% endblock %}
