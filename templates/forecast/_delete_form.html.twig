<form method="post" action="{{ path('app_forecast_delete', {'id': forecast.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ forecast.id) }}">
    {% if is_granted('ROLE_FORECAST_DELETE') %}
    <button class="btn btn-primary">Delete</button>
    {% endif %}
</form>
