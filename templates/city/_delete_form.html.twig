<form method="post" action="{{ path('app_city_delete', {'id': city.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ city.id) }}">
    {% if is_granted('ROLE_CITY_DELETE') %}
    <button class="btn btn-primary">Delete</button>
    {% endif %}
</form>
